# ios-app-factory Fastfile
# Only builds and uploads to TestFlight (internal). Metadata, screenshots, IAP and pricing are synced by
# `app-factory asc`, and review submission/release happen only via `app-factory release` after human approval.
# Do NOT add deliver/upload_to_app_store/submit_for_review lanes: the plugin hooks block them.

default_platform(:ios)

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_PRIVATE_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
  end

  desc "Archive and upload to TestFlight (internal testing only)"
  lane :beta do
    api_key = asc_api_key
    build_app(
      project: "__PROJECT_NAME__.xcodeproj",
      scheme: "__PROJECT_NAME__",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ".factory-tmp/build",
      derived_data_path: ".factory-tmp/DerivedData-archive",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ENV.fetch('ASC_PRIVATE_KEY_PATH')} " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      silent: true
    )
    upload_to_testflight(
      api_key: api_key,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
