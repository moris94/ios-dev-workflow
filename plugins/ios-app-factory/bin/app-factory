#!/usr/bin/env bash
# ios-app-factory CLI wrapper. On PATH while the plugin is enabled.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
PLUGIN_ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
VENV="${APP_FACTORY_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/ios-app-factory/venv}"

if [ "${1:-}" = "setup" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/python" -m pip install --quiet --upgrade pip
  "$VENV/bin/python" -m pip install --quiet -r "$PLUGIN_ROOT/requirements.txt"
  echo "ios-app-factory: dependencies installed in $VENV" >&2
  exit 0
fi

PY="python3"
if [ -x "$VENV/bin/python" ]; then PY="$VENV/bin/python"; fi
export PYTHONPATH="$PLUGIN_ROOT/lib${PYTHONPATH:+:$PYTHONPATH}"
export APP_FACTORY_PLUGIN_ROOT="$PLUGIN_ROOT"
exec "$PY" -m appfactory "$@"
