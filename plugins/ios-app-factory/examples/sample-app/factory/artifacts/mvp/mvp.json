{
  "version": "1.0.0",
  "scope_summary": "Quick capture, browse/edit/delete, Pro unlock for unlimited notes.",
  "features": [
    {
      "id": "F1",
      "name": "Quick capture",
      "description": "Add a note with title and text",
      "priority": "must",
      "principle_ids": [
        "P1"
      ],
      "acceptance_criteria": [
        "Add button opens editor with title focused",
        "Save is disabled for empty titles"
      ],
      "screens": [
        "home",
        "editor"
      ]
    },
    {
      "id": "F2",
      "name": "Browse & edit",
      "description": "List newest first, pinned on top; edit and delete",
      "priority": "must",
      "principle_ids": [
        "P1",
        "P2"
      ],
      "acceptance_criteria": [
        "List shows pinned notes first",
        "Swipe deletes a note"
      ],
      "screens": [
        "home",
        "editor"
      ]
    },
    {
      "id": "F3",
      "name": "Unlimited notes",
      "description": "Free tier holds 10 notes; Pro is unlimited",
      "priority": "must",
      "principle_ids": [
        "P3"
      ],
      "acceptance_criteria": [
        "Adding an 11th note on free tier opens the paywall",
        "After purchase, adding works"
      ],
      "screens": [
        "paywall",
        "settings"
      ],
      "requires_pro": true
    }
  ],
  "screens": [
    {
      "id": "home",
      "name": "Home",
      "purpose": "List notes"
    },
    {
      "id": "editor",
      "name": "Editor",
      "purpose": "Create/edit"
    },
    {
      "id": "paywall",
      "name": "Paywall",
      "purpose": "Unlock Pro"
    },
    {
      "id": "settings",
      "name": "Settings",
      "purpose": "Restore, links"
    }
  ],
  "data_model": [
    {
      "entity": "Item",
      "fields": [
        {
          "name": "title",
          "type": "String"
        },
        {
          "name": "note",
          "type": "String"
        },
        {
          "name": "createdAt",
          "type": "Date"
        },
        {
          "name": "isPinned",
          "type": "Bool"
        }
      ]
    }
  ],
  "monetization": {
    "model": "non_consumable",
    "products": [
      {
        "product_id": "com.example.stillnote.pro",
        "reference_name": "Pro (one-time)",
        "type": "NON_CONSUMABLE",
