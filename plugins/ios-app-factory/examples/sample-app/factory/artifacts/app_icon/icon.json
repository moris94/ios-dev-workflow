{
  "app_name": "Stillnote",
  "concept": {
    "name": "Leaf of paper",
    "metaphor": "A single quiet sheet of paper resting in a forest clearing, its corner folded like a leaf.",
    "rationale": "One sheet = one thought captured (P1 two-tap capture); no badges or noise (P2 calm by default). Forest gradient and paper tones come directly from the Forest Paper design concept.",
    "derived_from_principles": [
      "P1",
      "P2"
    ],
    "design_concept": "Forest Paper"
  },
  "aso": {
    "category": "PRODUCTIVITY",
    "keywords_reflected": [
      "notebook",
      "calm"
    ],
    "differentiation": "Productivity note apps mostly use yellow legal pads, pencils or blue/indigo squares; a deep forest field with a single pale sheet stands apart in search results.",
    "small_size_strategy": "One large high-contrast silhouette (pale sheet on deep green) with only two text lines as detail, so it still reads at 60px."
  },
  "references": [
    {
      "type": "guideline",
      "name": "Apple HIG — App icons",
      "source": "https://developer.apple.com/design/human-interface-guidelines/app-icons",
      "how_used": "Simple single focus point, no text, opaque background, provided dark and tinted appearances."
    },
    {
      "type": "skill",
      "name": "frontend-design",
      "source": "anthropics/skills",
      "how_used": "Checked the motif against the subject matter instead of generic note-app defaults."
    }
  ],
  "avoided": [
    "yellow legal pad",
    "pencil glyph",
    "indigo gradient square",
    "app name lettering"
  ],
