{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-app-factory/schemas/support_publication.schema.json",
  "title": "Support/privacy page publication",
  "type": "object",
  "required": [
    "provider",
    "url",
    "published_at"
  ],
  "properties": {
    "provider": {
      "enum": [
        "notion",
        "manual",
        "user"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "privacy_url": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "email_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "notion_page_id": {
      "type": "string"
    }
  }
}
