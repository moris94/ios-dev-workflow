{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-app-factory/schemas/app_icon.schema.json",
  "title": "App icon specification",
  "type": "object",
  "required": [
    "app_name",
    "concept",
    "aso",
    "references",
    "avoided",
    "background"
  ],
  "additionalProperties": false,
  "properties": {
    "app_name": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "type": "object",
      "required": [
        "name",
        "metaphor",
        "rationale",
        "derived_from_principles",
        "design_concept"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "metaphor": {
          "type": "string",
          "minLength": 10
        },
        "rationale": {
          "type": "string",
          "minLength": 40
        },
        "derived_from_principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "minItems": 1
        },
        "design_concept": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aso": {
      "type": "object",
      "required": [
        "category",
        "keywords_reflected",
        "differentiation",
        "small_size_strategy"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "keywords_reflected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "differentiation": {
          "type": "string",
          "minLength": 20
        },
        "small_size_strategy": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "source",
          "how_used"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "skill",
              "guideline",
              "inspiration"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "how_used": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "avoided": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2
    },
    "background": {
      "type": "object",
      "required": [
        "type",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "angle": {
          "type": "number"
        }
      }
    },
    "dark_background": {
      "type": "object",
      "required": [
        "type",
        "colors"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "angle": {
          "type": "number"
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shape",
          "role",
          "fill"
        ],
        "additionalProperties": false,
        "properties": {
          "shape": {
            "enum": [
              "circle",
              "ring",
              "ellipse",
              "rect",
              "rounded_rect",
              "polygon",
              "line",
              "arc"
            ]
          },
          "role": {
            "enum": [
              "glyph",
              "accent",
              "detail"
            ]
          },
          "fill": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "dark_fill": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "opacity": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 1
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 1.5
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": {
            "type": "number",
            "minimum": 0.005,
            "maximum": 1
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 1.5
            },
            "minItems": 4,
            "maxItems": 4
          },
          "corner": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -0.5,
                "maximum": 1.5
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 64
          },
          "width": {
            "type": "number",
            "minimum": 0.005,
            "maximum": 0.3
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "maxItems": 24
    },
    "extra_colors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hex",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "source_png": {
      "type": "string"
    },
    "source_png_dark": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "layers"
      ],
      "properties": {
        "layers": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "source_png"
      ]
    }
  ]
}
