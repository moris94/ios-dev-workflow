{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-app-factory/schemas/config.schema.json",
  "title": "Factory configuration",
  "type": "object",
  "required": [
    "app",
    "asc",
    "screenshots",
    "release"
  ],
  "properties": {
    "app": {
      "type": "object",
      "required": [
        "name",
        "bundle_id",
        "version",
        "build_number",
        "primary_locale",
        "locales",
        "min_ios"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
        },
        "team_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "build_number": {
          "type": "integer",
          "minimum": 1
        },
        "primary_locale": {
          "const": "en-US"
        },
        "locales": {
          "type": "array",
          "items": {
            "enum": [
              "en-US",
              "ja"
            ]
          },
          "minItems": 2,
          "uniqueItems": true,
          "allContains": {
            "const": "ja"
          }
        },
        "min_ios": {
          "type": "string",
          "pattern": "^1[7-9](\\.[0-9])?$|^2[0-9](\\.[0-9])?$"
        },
        "scheme": {
          "type": "string"
        },
        "project_name": {
          "type": "string"
        },
        "links": {
          "type": "object",
          "properties": {
            "support": {
              "type": [
                "string",
                "null"
              ]
            },
            "privacy_policy": {
              "type": [
                "string",
                "null"
              ]
            },
            "terms": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "first_release": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": [],
      "properties": {
        "min_competitors": {
          "type": "integer",
          "minimum": 1
        },
        "min_sources": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "asc": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dry-run",
            "apply"
          ]
        },
        "app_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_base_territory": {
          "type": "string"
        },
        "remote_fixture": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "screenshots": {
      "type": "object",
      "required": [
        "devices"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "fonts": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": [],
      "properties": {
        "require_manual_purchase_test": {
          "type": "boolean"
        },
        "approval_ttl_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 720
        },
        "release_type": {
          "const": "MANUAL"
        }
      },
      "additionalProperties": true
    },
    "locks": {
      "type": "object",
      "required": [],
      "properties": {
        "stale_after_minutes": {
          "type": "number",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
