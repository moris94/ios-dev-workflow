{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ios-app-factory/schemas/proposal.schema.json",
  "title": "App proposal",
  "type": "object",
  "required": [
    "app_name_working",
    "one_liner",
    "problem",
    "target_users",
    "value_proposition",
    "differentiation",
    "key_features",
    "monetization_hypothesis",
    "success_metrics",
    "risks"
  ],
  "properties": {
    "app_name_working": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "problem": {
      "type": "string",
      "minLength": 40
    },
    "target_users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "persona",
          "needs"
        ],
        "properties": {
          "persona": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "value_proposition": {
      "type": "string",
      "minLength": 20
    },
    "differentiation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "point",
          "vs_competitors",
          "evidence_source_ids"
        ],
        "properties": {
          "point": {
            "type": "string",
            "minLength": 1
          },
          "vs_competitors": {
            "type": "string",
            "minLength": 1
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S[0-9]+$"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "key_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "priority"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 3
    },
    "monetization_hypothesis": {
      "type": "object",
      "required": [
        "model",
        "rationale"
      ],
      "properties": {
        "model": {
          "enum": [
            "non_consumable",
            "subscription",
            "consumable",
            "paid_app",
            "free"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "price_usd_hint": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "success_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "target"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
